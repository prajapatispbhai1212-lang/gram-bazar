        .container {
            width: min(1100px, 94%);
            margin: auto;
        }

        .hero {
            background: linear-gradient(135deg, #14532d, #32934f);
            color: white;
            text-align: center;
            padding: 40px 15px;
        }

        .hero h1 {
            font-size: clamp(28px, 5vw, 40px);
