                grid-template-columns: 1fr;
            }

            .summary {
                order: -1;
            }
        }

        @media (max-width: 480px) {
            .cart-panel,
            .summary {
                padding: 15px;
            }

            .cart-item {
                grid-template-columns: 64px minmax(0, 1fr);
                gap: 12px;
            }

            .item-image {
                width: 64px;
                height: 64px;
                font-size: 32px;
            }

            .item-right {
                grid-column: 2;
                display: flex;
                justify-content: space-between;
                align-items: center;
