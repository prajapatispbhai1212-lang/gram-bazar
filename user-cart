    </style>
</head>

<body>

    <!-- Common Navigation Bar -->
    <div id="common-nav"></div>

    <header class="hero">
        <div class="container">
            <h1>🛒 मेरा कार्ट</h1>
            <p>आपके पसंदीदा स्थानीय उत्पाद एक ही जगह पर।</p>
        </div>
    </header>

    <main class="container">

        <div class="breadcrumb">
            <a href="index.html">होम</a>
            <span> / मेरा कार्ट</span>
        </div>

        <div class="cart-heading">
            <h2>आपकी खरीदारी</h2>
        </div>

        <section class="cart-layout">

            <!-- Cart Products -->
            <div class="cart-panel">

                <div id="cart-items"></div>

                <div class="empty-cart" id="empty-cart" hidden>
                    <div class="empty-icon">🛒</div>
                    <h2>आपका कार्ट खाली है!</h2>
                    <p>अभी अपने पसंदीदा उत्पाद कार्ट में जोड़ें।</p>
                    <a href="index.html">खरीदारी शुरू करें</a>
                </div>

                <a class="continue-btn" href="index.html">
                    ← खरीदारी जारी रखें
                </a>

            </div>

            <!-- Order Summary -->
            <aside class="summary">

                <h2>ऑर्डर समरी</h2>

                <div class="summary-row">
                    <span>कुल उत्पाद</span>
                    <span id="total-items">0</span>
                </div>

                <div class="summary-row">
                    <span>उत्पादों की कीमत</span>
                    <span id="subtotal">₹0</span>
                </div>

                <div class="summary-row">
                    <span>डिलीवरी शुल्क</span>
                    <span id="delivery">₹0</span>
                </div>

                <div class="summary-row summary-total">
                    <span>कुल राशि</span>
                    <span id="grand-total">₹0</span>
                </div>

                <button class="checkout-btn" id="checkout-btn" disabled>
                    ऑर्डर करने के लिए आगे बढ़ें →
                </button>

                <button class="clear-btn" id="clear-cart">
                    🗑️ पूरा कार्ट खाली करें
                </button>

                <div class="cart-note">
                    🔒 यह अभी एक फ्रंटएंड डेमो है। वास्तविक ऑर्डर और
                    भुगतान के लिए बैकएंड या सुरक्षित पेमेंट सेवा आवश्यक है।
                </div>

            </aside>

        </section>

    </main>

    <footer>
        <p>
            © <span id="current-year"></span> Gram Bazar.
            सभी अधिकार सुरक्षित।
        </p>
        <p style="margin-top: 7px;">
            स्थानीय व्यापार को डिजिटल पहचान देने की पहल 🌱
        </p>
    </footer>

    <div class="toast" id="toast" role="status" aria-live="polite"></div>

    <script>
        const CART_KEY = "gramBazarCart";

        const cartItems = document.getElementById("cart-items");
        const emptyCart = document.getElementById("empty-cart");
        const totalItems = document.getElementById("total-items");
        const subtotalElement = document.getElementById("subtotal");
        const deliveryElement = document.getElementById("delivery");
        const grandTotalElement = document.getElementById("grand-total");
        const checkoutBtn = document.getElementById("checkout-btn");
        const toast = document.getElementById("toast");

        document.getElementById("current-year").textContent =
            new Date().getFullYear();

        let toastTimer;

        function money(amount) {
            return "₹" + Number(amount).toLocaleString("en-IN", {
                maximumFractionDigits: 2
            });
        }

        function readCart() {
            try {
                const data = JSON.parse(
                    localStorage.getItem(CART_KEY) || "[]"
                );

                if (!Array.isArray(data)) return [];

                return data
                    .filter(item =>
                        item &&
                        typeof item.id === "string" &&
                        typeof item.name === "string" &&
                        Number.isFinite(Number(item.price)) &&
                        Number(item.price) >= 0
                    )
                    .map(item => ({
                        ...item,
                        price: Number(item.price),
                        quantity: Math.min(
                            99,
                            Math.max(1, Math.floor(Number(item.quantity) || 1))
                        )
                    }));
            } catch (error) {
                return [];
            }
        }

        function saveCart(cart) {
            try {
                localStorage.setItem(CART_KEY, JSON.stringify(cart));
                return true;
            } catch (error) {
                showToast("कार्ट सेव नहीं हो सका।");
                return false;
            }
        }

        function showToast(text) {
            toast.textContent = text;
            toast.style.display = "block";

            clearTimeout(toastTimer);

            toastTimer = setTimeout(() => {
                toast.style.display = "none";
            }, 2500);
        }

        function updateQuantity(id, change) {
            const cart = readCart();
            const item = cart.find(product => product.id === id);

            if (!item) return;

            item.quantity = Math.min(99, item.quantity + change);

            if (item.quantity < 1) {
                return;
            }

            if (saveCart(cart)) renderCart();
        }

        function removeItem(id) {
            const cart = readCart().filter(item => item.id !== id);

            if (saveCart(cart)) {
                renderCart();
                showToast("उत्पाद कार्ट से हटा दिया गया।");
            }
        }

        function renderCart() {
            const cart = readCart();

            cartItems.innerHTML = "";

            emptyCart.hidden = cart.length !== 0;
            cartItems.style.display = cart.length === 0 ? "none" : "block";

            let subtotal = 0;
            let quantityTotal = 0;

            cart.forEach(item => {
                const quantity = item.quantity;
                const price = item.price;
                const lineTotal = price * quantity;

                subtotal += lineTotal;
                quantityTotal += quantity;

                const article = document.createElement("article");
                article.className = "cart-item";

                const image = document.createElement("div");
                image.className = "item-image";

                // Display an emoji or a safe local image path.
                const imageValue = typeof item.image === "string"
                    ? item.image
                    : "";

                if (
                    imageValue &&
                    !/[\u{1F300}-\u{1FAFF}\u{2600}-\u{27BF}]/u.test(imageValue) &&
                    /^images\/[a-zA-Z0-9._/-]+$/.test(imageValue) &&
                    !imageValue.includes("..")
                ) {
                    const img = document.createElement("img");
                    img.src = imageValue;
                    img.alt = item.name;
                    img.onerror = () => {
                        img.remove();
                        image.textContent = "🛍️";
                    };
                    image.appendChild(img);
                } else {
                    image.textContent = imageValue || "🛍️";
                }

                const info = document.createElement("div");

                const name = document.createElement("h3");
                name.className = "item-name";
                name.textContent = item.name;

                const priceElement = document.createElement("div");
                priceElement.className = "item-price";
                priceElement.textContent = money(price);

                const controls = document.createElement("div");
                controls.className = "quantity-control";

                const minus = document.createElement("button");
                minus.type = "button";
                minus.textContent = "−";
                minus.setAttribute("aria-label", item.name + " की मात्रा घटाएं");
                minus.addEventListener("click", () => {
                    if (quantity === 1) {
                        removeItem(item.id);
                    } else {
                        updateQuantity(item.id, -1);
                    }
                });

                const qty = document.createElement("span");
                qty.textContent = quantity;

                const plus = document.createElement("button");
                plus.type = "button";
                plus.textContent = "+";
                plus.setAttribute("aria-label", item.name + " की मात्रा बढ़ाएं");
                plus.disabled = quantity >= 99;
                plus.addEventListener("click", () => {
                    if (quantity < 99) updateQuantity(item.id, 1);
                });

                controls.append(minus, qty, plus);
                info.append(name, priceElement, controls);

                const right = document.createElement("div");
                right.className = "item-right";

                const total = document.createElement("div");
                total.className = "item-total";
                total.textContent = money(lineTotal);

                const remove = document.createElement("button");
                remove.type = "button";
                remove.className = "remove-btn";
                remove.textContent = "🗑️ हटाएं";
                remove.addEventListener("click", () => removeItem(item.id));

                right.append(total, remove);
                article.append(image, info, right);
                cartItems.appendChild(article);
            });

            // Delivery is displayed as ₹0 in this demo.
            const delivery = 0;
            const grandTotal = subtotal + delivery;

            totalItems.textContent = quantityTotal;
            subtotalElement.textContent = money(subtotal);
            deliveryElement.textContent = money(delivery);
            grandTotalElement.textContent = money(grandTotal);

            checkoutBtn.disabled = cart.length === 0;
        }

        document.getElementById("clear-cart").addEventListener("click", () => {
            const cart = readCart();

            if (cart.length === 0) {
                showToast("कार्ट पहले से खाली है।");
                return;
            }

            if (confirm("क्या आप पूरा कार्ट खाली करना चाहते हैं?")) {
                if (saveCart([])) {
                    renderCart();
                    showToast("आपका कार्ट खाली कर दिया गया।");
                }
            }
        });

        checkoutBtn.addEventListener("click", () => {
            if (readCart().length === 0) {
                showToast("पहले कार्ट में उत्पाद जोड़ें।");
                return;
            }

            showToast("ऑर्डर और भुगतान सुविधा अभी सेटअप करनी बाकी है।");
        });

        // Refresh cart if another tab updates the same cart.
        window.addEventListener("storage", event => {
            if (event.key === CART_KEY) renderCart();
        });

        renderCart();
    </script>

    <!-- Common Navigation -->
    <script src="common-nav.js"></script>

</body>
</html>
